# Your Soge API key — get one at https://soge.dk/pricing (free tier available).
# The same key meters both REST and MCP usage against your plan.
SOGE_API_KEY=

# API origin (rarely changed).
SOGE_API_BASE=https://soge.dk

# Transport: "stdio" (default, for Claude Desktop/Code/Cursor) or "streamable-http" (hosted).
SOGE_MCP_TRANSPORT=stdio

# Only for streamable-http:
SOGE_MCP_HOST=127.0.0.1
SOGE_MCP_PORT=8000
